{
  "dataset": "xnli",
  "instr_lang": "en",
  "state_schema": [
    "premise",
    "hypothesis"
  ],
  "instructions": "Given `premise`, is `hypothesis` true, undetermined, or false?",
  "criteria": {
    "entailment": "`premise` makes `hypothesis` true.",
    "neutral": "`premise` neither makes `hypothesis` true nor false.",
    "contradiction": "`premise` makes `hypothesis` false."
  }
}
